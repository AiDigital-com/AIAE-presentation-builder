<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.aidigital.reportconstructor</groupId>
		<artifactId>app-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>external-services</artifactId>
	<name>Report Constructor — external-services</name>
	<packaging>jar</packaging>


	<!-- Coverage floor for this module, below the parent's 0.80/0.70 target.
		 Today this module sits at 0.6051 line / 0.5132 branch.
		 The Claude and Google clients are mostly request assembly and response
			 parsing against live APIs, and the stub providers exist to avoid calling
			 them in tests — so a large share of this module is only reached by code
			 paths the unit suite deliberately does not take.

		 These numbers are a ratchet: they stop coverage sliding while work continues
		 on debt they did not create. Raise them as coverage rises; delete this block
		 when the module meets the parent gate. -->
	<properties>
		<jacoco.line.coverage>0.60</jacoco.line.coverage>
		<jacoco.branch.coverage>0.51</jacoco.branch.coverage>
	</properties>

