<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.aidigital.reportconstructor</groupId>
		<artifactId>app-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>service</artifactId>
	<name>AIAE Presentation Builder - service</name>
	<packaging>jar</packaging>


	<!-- Coverage floor for this module, below the parent's 0.80/0.70 target.
		 Today this module sits at 0.7919 line / 0.6402 branch.
		 Measured on the suite that ships with this commit. The branch gap is the
			 larger one: the report engine's resolvers are a wide tree of fallbacks and
			 only the taken paths are exercised.

		 These numbers are a ratchet: they stop coverage sliding while work continues
		 on debt they did not create. Raise them as coverage rises; delete this block
		 when the module meets the parent gate. -->
	<properties>
		<jacoco.line.coverage>0.78</jacoco.line.coverage>
		<jacoco.branch.coverage>0.63</jacoco.branch.coverage>
	</properties>

	<dependencies>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>domain</artifactId>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>event-logging-to-db-feature</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
		</dependency>
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>
		<!-- jakarta.validation: needed for ValidationMessage annotations. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Test scope — mockito + junit + assertj + spring-test bundled. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
