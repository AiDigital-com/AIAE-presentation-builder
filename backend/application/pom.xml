<?xml version="1.0" encoding="UTF-8"?>
<!--
  Application module — the ONLY module with @SpringBootApplication and the
  ONLY one activating spring-boot-maven-plugin (repackage). <start-class>
  points repackage at the main class. Pulls in service (+ domain transitively)
  and db (Liquibase changelogs in fat jar).
  Generated OpenAPI sources in target/generated-sources/openapi.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.aidigital.reportconstructor</groupId>
		<artifactId>app-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>application</artifactId>
	<name>AIAE Presentation Builder - application</name>

	<properties>
		<!-- Must match FQN of @SpringBootApplication class. Consumed by
			 parent pluginManagement's <mainClass>${start-class}. -->
		<start-class>${project.groupId}.Application</start-class>
	</properties>


	<dependencies>
		<!-- REQUIRED edges: application → service / domain (compiled against) and the
			 runtime-only modules below. external-services reaches the fat jar through service, never
			 directly. No application class references observability or migrations, but their beans
			 (metrics, usage-logging aspect) and the Liquibase changelogs MUST be in the fat jar. -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>service</artifactId>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>domain</artifactId>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>observability</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>migrations</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Libraries the application code compiles against (AIAE dependency analysis:
			 declare what is used; the starters further down only assemble the runtime). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-autoconfigure</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-beans</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-webmvc</artifactId>
		</dependency>
		<!-- Servlet API as shipped by the embedded container. Declared as tomcat-embed-core
			 (not jakarta.servlet-api) so the fat jar does not carry the servlet classes twice. -->
		<dependency>
			<groupId>org.apache.tomcat.embed</groupId>
			<artifactId>tomcat-embed-core</artifactId>
			<!-- Same exclusion as spring-boot-starter-tomcat. -->
			<exclusions>
				<exclusion>
					<groupId>org.apache.tomcat</groupId>
					<artifactId>tomcat-annotations-api</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>jakarta.validation</groupId>
			<artifactId>jakarta.validation-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-annotations</artifactId>
		</dependency>
		<dependency>
			<groupId>io.swagger.core.v3</groupId>
			<artifactId>swagger-annotations-jakarta</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-config</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-jose</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-resource-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.zalando</groupId>
			<artifactId>logbook-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.zalando</groupId>
			<artifactId>logbook-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.zalando</groupId>
			<artifactId>logbook-json</artifactId>
		</dependency>

		<!-- Runtime assembly: web + validation + security + AOP + JPA + actuator -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aop</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- OpenAPI: SpringDoc UI -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Observability -->
		<dependency>
			<groupId>net.logstash.logback</groupId>
			<artifactId>logstash-logback-encoder</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.zalando</groupId>
			<artifactId>logbook-spring-boot-starter</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- json-path (pulled in by logbook-json) needs json-smart at runtime. It used to reach
			 the fat jar only through Maven scope mediation via spring-boot-starter-test; declare
			 it so the runtime classpath does not depend on the test scope. -->
		<dependency>
			<groupId>net.minidev</groupId>
			<artifactId>json-smart</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Lombok + MapStruct (for ServiceRecord ↔ ApiDto mappers) -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
		</dependency>
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
		</dependency>

		<!-- Runtime DB driver -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- AWS Advanced JDBC Wrapper. Only the eks profile uses it: there the
			 JDBC URL is jdbc:aws-wrapper:postgresql://... and the awsSecretsManager
			 plugin reads the database username and password from the RDS-managed
			 master user secret through the pod's IRSA role. When PostgreSQL rejects
			 a login because AWS rotated that password, the plugin refetches the
			 secret and retries, so a rotation never reaches the application: no pod
			 restart, and no second copy of the password that could fall out of
			 sync. Local, replit and test runs keep the plain driver above. Runtime
			 scope, like that driver: no Java class refers to either, both are found
			 through JDBC driver discovery. -->
		<dependency>
			<groupId>software.amazon.jdbc</groupId>
			<artifactId>aws-advanced-jdbc-wrapper</artifactId>
			<version>2.6.0</version>
			<scope>runtime</scope>
		</dependency>
		<!-- The wrapper declares the Secrets Manager SDK as optional, so the
			 awsSecretsManager plugin above cannot fetch anything without it. This
			 is the only AWS SDK artifact in the project: the application calls no
			 other AWS API, and its generated artifacts live in Google Slides and
			 Sheets rather than S3. -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>secretsmanager</artifactId>
			<version>2.29.45</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Test scope -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Test libraries the tests compile against directly. -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-params</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-test-autoconfigure</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- H2 — used by application-test.yml so ApplicationSmokeTest boots
			 without Postgres. LiquibaseChangelogSmokeTest uses real Postgres
			 via Testcontainers and ignores H2. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Repackage into executable jar. Configuration (mainClass,
				 excludes) inherited from parent pluginManagement. -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- Writes git.properties, read at runtime by GitVersionServiceImpl
				 and exposed through the system API. Bound HERE and not in the
				 parent's <build><plugins>: inherited by every module it produced a
				 copy per module, all of which land on the executable jar's
				 classpath, so the one actually read depended on classpath order.
				 This module's classes directory becomes BOOT-INF/classes, which is
				 searched before the jars in BOOT-INF/lib, so one copy here is both
				 sufficient and unambiguous. Configuration (prefix, offline,
				 failOnNoGitDirectory) is inherited from the parent's
				 pluginManagement. -->
			<plugin>
				<groupId>io.github.git-commit-id</groupId>
				<artifactId>git-commit-id-maven-plugin</artifactId>
			</plugin>

			<!-- Generate Spring interfaces + DTOs from openapi.yaml.
				 Configuration inherited from parent pluginManagement;
				 only this module has an openapi.yaml to generate from. -->
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
			</plugin>

			<!-- No frontend plugin here on purpose. The SPA is built by an
				 explicit npm step in scripts/replit-build.sh, which writes to
				 src/main/resources/static/ before this module packages;
				 spring-boot-maven-plugin then bundles static/ into the fat jar.
				 Keeping npm out of the reactor means backend and frontend
				 rebuild independently — see scripts/local-dev-*.sh. -->
		</plugins>
	</build>

	<!-- Coverage phase `mvp` (.template-phase): this module meets the strict gate (0.9772 line / 0.9417 branch,
		 2026-11-13, generated OpenAPI types excluded as in the check), so it stays strict in the MVP phase too.
		 A bare `mvn verify` holds this module to the parent's strict 0.80 / 0.70. -->
	<profiles>
		<profile>
			<id>mvp</id>
			<properties>
				<jacoco.line.coverage>0.80</jacoco.line.coverage>
				<jacoco.branch.coverage>0.70</jacoco.branch.coverage>
			</properties>
		</profile>
	</profiles>

</project>
