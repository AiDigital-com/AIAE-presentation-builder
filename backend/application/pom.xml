<?xml version="1.0" encoding="UTF-8"?>
<!--
  Application module — the ONLY module with @SpringBootApplication and the
  ONLY one activating spring-boot-maven-plugin (repackage). <start-class>
  points repackage at the main class. Pulls in service (+ domain transitively)
  and db (Liquibase changelogs in fat jar).
  Generated OpenAPI sources in target/generated-sources/openapi.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.aidigital.reportconstructor</groupId>
		<artifactId>app-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>application</artifactId>
	<name>AIAE Presentation Builder - application</name>

	<properties>
		<!-- Must match FQN of @SpringBootApplication class. Consumed by
			 parent pluginManagement's <mainClass>${start-class}. -->
		<start-class>${project.groupId}.Application</start-class>

		<!-- Coverage floor for this module, below the parent's 0.80/0.70 target.
			 Today this module sits at 0.4296 line / 0.3846 branch. The thinnest layer and
			 the lowest number: controllers delegating to services that are themselves
			 covered, plus Spring configuration. Measured with LiquibaseChangelogSmokeTest
			 erroring for want of a local Docker daemon, so the real figure is this or
			 higher.

			 These numbers are a ratchet: they stop coverage sliding while work continues on
			 debt they did not create. Raise them as coverage rises; delete them when the
			 module meets the parent gate. -->
		<jacoco.line.coverage>0.42</jacoco.line.coverage>
		<jacoco.branch.coverage>0.38</jacoco.branch.coverage>
	</properties>


	<dependencies>
		<!-- REQUIRED edges (drop either → broken):
			   application → service (transitively brings domain)
			   application → db      (Liquibase changelogs MUST be in fat jar) -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>service</artifactId>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>external-services</artifactId>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>migrations</artifactId>
		</dependency>

		<!-- Web + security + AOP + actuator -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aop</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<!-- OpenAPI: SpringDoc UI + generator runtime types -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
		</dependency>

		<!-- Observability -->
		<dependency>
			<groupId>net.logstash.logback</groupId>
			<artifactId>logstash-logback-encoder</artifactId>
		</dependency>
		<dependency>
			<groupId>org.zalando</groupId>
			<artifactId>logbook-spring-boot-starter</artifactId>
		</dependency>

		<!-- CSV export endpoints -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-csv</artifactId>
		</dependency>

		<!-- Lombok + MapStruct (for ServiceRecord ↔ ApiDto mappers) -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
		</dependency>
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
		</dependency>

		<!-- Runtime DB driver -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- AWS Advanced JDBC Wrapper. Only the eks profile uses it: there the
			 JDBC URL is jdbc:aws-wrapper:postgresql://... and the awsSecretsManager
			 plugin reads the database username and password from the RDS-managed
			 master user secret through the pod's IRSA role. When PostgreSQL rejects
			 a login because AWS rotated that password, the plugin refetches the
			 secret and retries, so a rotation never reaches the application: no pod
			 restart, and no second copy of the password that could fall out of
			 sync. Local, replit and test runs keep the plain driver above. Runtime
			 scope, like that driver: no Java class refers to either, both are found
			 through JDBC driver discovery. -->
		<dependency>
			<groupId>software.amazon.jdbc</groupId>
			<artifactId>aws-advanced-jdbc-wrapper</artifactId>
			<version>2.6.0</version>
			<scope>runtime</scope>
		</dependency>
		<!-- The wrapper declares the Secrets Manager SDK as optional, so the
			 awsSecretsManager plugin above cannot fetch anything without it. This
			 is the only AWS SDK artifact in the project: the application calls no
			 other AWS API, and its generated artifacts live in Google Slides and
			 Sheets rather than S3. -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>secretsmanager</artifactId>
			<version>2.29.45</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Test scope -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- H2 — used by application-test.yml so ApplicationSmokeTest boots
			 without Postgres. LiquibaseChangelogSmokeTest uses real Postgres
			 via Testcontainers and ignores H2. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Repackage into executable jar. Configuration (mainClass,
				 excludes) inherited from parent pluginManagement. -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- Writes git.properties, read at runtime by GitVersionServiceImpl
				 and exposed through the system API. Bound HERE and not in the
				 parent's <build><plugins>: inherited by every module it produced a
				 copy per module, all of which land on the executable jar's
				 classpath, so the one actually read depended on classpath order.
				 This module's classes directory becomes BOOT-INF/classes, which is
				 searched before the jars in BOOT-INF/lib, so one copy here is both
				 sufficient and unambiguous. Configuration (prefix, offline,
				 failOnNoGitDirectory) is inherited from the parent's
				 pluginManagement. -->
			<plugin>
				<groupId>io.github.git-commit-id</groupId>
				<artifactId>git-commit-id-maven-plugin</artifactId>
			</plugin>

			<!-- Generate Spring interfaces + DTOs from openapi.yaml.
				 Configuration inherited from parent pluginManagement;
				 only this module has an openapi.yaml to generate from. -->
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
			</plugin>

			<!-- No frontend plugin here on purpose. The SPA is built by an
				 explicit npm step in scripts/replit-build.sh, which writes to
				 src/main/resources/static/ before this module packages;
				 spring-boot-maven-plugin then bundles static/ into the fat jar.
				 Keeping npm out of the reactor means backend and frontend
				 rebuild independently — see scripts/local-dev-*.sh. -->
		</plugins>
	</build>
</project>
