<?xml version="1.0" encoding="UTF-8"?>
<!-- Liquibase changelogs only. `application` depends on `db` so changelogs
     land on the classpath at runtime for Spring Boot's Liquibase auto-config.
     No Java code (custom-change Java classes would live here if needed). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.aidigital.reportconstructor</groupId>
		<artifactId>app-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>db</artifactId>
	<name>AIAE Presentation Builder - db</name>
	<packaging>jar</packaging>

	<dependencies>
		<dependency>
			<groupId>org.liquibase</groupId>
			<artifactId>liquibase-core</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Runs the changelog from the Argo CD PreSync Job in the paired
				 liquibase-* image:

				   mvn -f backend/pom.xml -pl db liquibase:update \
				       -Dliquibase.url=... -Dliquibase.username=... -Dliquibase.password=...

				 No <executions>: the goal is only ever invoked explicitly and is
				 never bound to a lifecycle phase, so an ordinary `mvn package`
				 never touches a database.

				 changeLogFile is the CLASSPATH path, identical to
				 spring.liquibase.change-log in application.yml. Liquibase records
				 applied changesets by (id, author, filename) where filename is
				 that path. A filesystem path such as
				 src/main/resources/db/changelog/db.changelog-master.xml would be
				 recorded as a DIFFERENT filename, so every changeset would look
				 unapplied and re-run against a populated schema. -->
			<plugin>
				<groupId>org.liquibase</groupId>
				<artifactId>liquibase-maven-plugin</artifactId>
				<configuration>
					<changeLogFile>db/changelog/db.changelog-master.xml</changeLogFile>
					<!-- Fail loudly instead of prompting for input in a Job that has no TTY. -->
					<promptOnNonLocalDatabase>false</promptOnNonLocalDatabase>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>org.postgresql</groupId>
						<artifactId>postgresql</artifactId>
						<version>${postgresql.version}</version>
					</dependency>
				</dependencies>
			</plugin>
		</plugins>
	</build>
</project>
