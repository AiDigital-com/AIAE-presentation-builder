{
  "name": "reportconstructor-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../backend/application/src/main/resources/api/v1/specs/openapi.yaml -o src/shared/api/generated/schema.d.ts",
    "check:api": "npm run generate:api && tsc --noEmit",
    "prepare": "node scripts/prepare-husky.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.20.0",
    "@tanstack/react-query": "^5.62.0",
    "openapi-fetch": "^0.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
